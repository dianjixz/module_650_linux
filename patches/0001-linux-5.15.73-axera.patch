+		phy_num =  DPHY7_NUMBER;
+		break;
+	case 39 ... 40:
+		CORE_DIG_IOCTRL_RW_AFE_LANE_CTRL_2_1_offset = CORE_DIG_IOCTRL_RW_AFE_LANE0_CTRL_2_1_offset;
+		phy_num =  DPHY7_NUMBER;
