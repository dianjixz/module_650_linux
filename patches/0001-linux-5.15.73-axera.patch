+	value |= (0x1 << PCLK_USB2_PHY_EB);	//phy cr2apb pclk
+	writel(value, addr);
+	iounmap(addr);
+
+	addr = ioremap(FLASH_CLK_MUX_0, 4);
+	value = readl(addr);
+	value &= ~CLK_FLASH_GLB_SEL;
+	value |= (0x1 << 5); 	//bus_clk freq: 0:24M, 1:200M, 2:350M
