+				JL2XXX_WOL_STAS_REG, JL2XXX_WOL_EN);
+		jlsemi_clear_bits(phydev, JL2XXX_WOL_STAS_PAGE,
+				  JL2XXX_WOL_STAS_REG, JL2XXX_WOL_GLB_EN);
+	} else {
+		jlsemi_clear_bits(phydev, JL2XXX_WOL_STAS_PAGE,
+				  JL2XXX_WOL_STAS_REG, JL2XXX_WOL_EN);
+	}
+	jlsemi_soft_reset(phydev);
+
+	return 0;
+}
