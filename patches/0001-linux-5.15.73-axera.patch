+static int hdmi_device_attrs_add(struct drm_connector *connector)
+{
+	int ret = 0;
+	struct dw_hdmi *hdmi = container_of(connector, struct dw_hdmi,
+					     connector);
+
+	if (hdmi->connector.kdev) {
+		ret = device_create_file(hdmi->connector.kdev, &dev_attr_phy_reg);
+		if (ret)
+			goto exit;
+
+		ret = device_create_file(hdmi->connector.kdev, &dev_attr_scdc_status);
+		if (ret) {
+			device_remove_file(hdmi->connector.kdev, &dev_attr_phy_reg);
+			goto exit;
+		}
+
+		ret = device_create_file(hdmi->connector.kdev, &dev_attr_id);
+		if (ret) {
+			device_remove_file(hdmi->connector.kdev, &dev_attr_scdc_status);
+			device_remove_file(hdmi->connector.kdev, &dev_attr_phy_reg);
+			goto exit;
+		}
+	}
+
+exit:
+	return ret;
+}
+
+static void hdmi_device_attrs_remove(struct drm_connector *connector)
+{
+	struct dw_hdmi *hdmi = container_of(connector, struct dw_hdmi,
+					     connector);
+
+	if (hdmi->connector.kdev) {
+		device_remove_file(hdmi->connector.kdev, &dev_attr_phy_reg);
+		device_remove_file(hdmi->connector.kdev, &dev_attr_scdc_status);
+		device_remove_file(hdmi->connector.kdev, &dev_attr_id);
+	}
+}
+
+static int hdmi_connector_atomic_set_property(struct drm_connector *connector,
+					struct drm_connector_state *state,
+					struct drm_property *property,
+					uint64_t val)
+{
+	struct dw_hdmi *hdmi = container_of(connector, struct dw_hdmi, connector);
+
+	if (property == hdmi->props.hdmi_mode) {
+		hdmi->hdmi_mode = val;
+		hdmi->sink_is_hdmi = hdmi->hdmi_mode ? true : false;
+		hdmi->sink_has_audio = hdmi->hdmi_mode ? true : false;
+
+	} else if (property == hdmi->props.hdmi_out_fmt) {
+		hdmi->hdmi_out_fmt = val;
+
+		switch (hdmi->hdmi_out_fmt) {
+		case AX_HDMI_VIDEO_MODE_RGB444:
+			connector->display_info.color_formats = DRM_COLOR_FORMAT_RGB444;
+			break;
+		case AX_HDMI_VIDEO_MODE_YUV444:
+			connector->display_info.color_formats = DRM_COLOR_FORMAT_YCRCB444;
+			break;
+		case AX_HDMI_VIDEO_MODE_YUV422:
+			connector->display_info.color_formats = DRM_COLOR_FORMAT_YCRCB422;
+			break;
+		case AX_HDMI_VIDEO_MODE_YUV420:
+			connector->display_info.color_formats = DRM_COLOR_FORMAT_YCRCB420;
+			break;
+		default:
+			connector->display_info.color_formats = DRM_COLOR_FORMAT_RGB444;
+			break;
+		}
+	} else if (property == hdmi->props.input_quantization_range) {
+		hdmi->input_quantization_range = val;
+	} else if (property == hdmi->props.output_quantization_range) {
+		hdmi->output_quantization_range = val;
+	} else if (property == hdmi->props.phy_init_count) {
+		hdmi->phy_init_count = val;
+	}
+
+	return 0;
+}
+
+static int hdmi_connector_atomic_get_property(struct drm_connector *connector,
+					const struct drm_connector_state *state, struct drm_property *property,
+					uint64_t * val)
+{
+	struct dw_hdmi *hdmi = container_of(connector, struct dw_hdmi, connector);
+
+	if (property == hdmi->props.hdmi_mode)
+		*val = hdmi->hdmi_mode;
+	else if (property == hdmi->props.hdmi_out_fmt)
+		*val = hdmi->hdmi_out_fmt;
+	else if (property == hdmi->props.input_quantization_range)
+		*val = hdmi->input_quantization_range;
+	else if (property == hdmi->props.output_quantization_range)
+		*val = hdmi->output_quantization_range;
+	else if (property == hdmi->props.phy_init_count)
+		*val = hdmi->phy_init_count;
+
+	return 0;
+}
