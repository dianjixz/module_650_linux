+
+static int tp2912_read(struct regmap *regmap, u8 reg, u8 *val)
+{
+	int ret;
+	unsigned int regval;
+
+	ret = regmap_read(regmap, reg, &regval);
+	if (ret) {
+		pr_err("%s read from tp2912@%x failed, ret = %d\n", __func__, reg, ret);
+		return ret;
+	}
+
+	*val = regval & 0xff;
+
+	return 0;
+}
+
+static int tp2912_write(struct regmap *regmap, u8 reg, u8 val)
+{
+	int ret;
+
+	ret = regmap_write(regmap, reg, val);
+	if (ret) {
+		pr_err("%s write [0x%x, 0x%x] to tp2912 failed, ret = %d\n", __func__, reg, val, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void tp2912_cfg_write(struct regmap *regmap, struct reg_cfg *cfg)
+{
+	while (cfg->addr != 0xff) {
+		pr_info("%s addr: %x, data: %x\n", __func__, cfg->addr, cfg->data);
+		tp2912_write(regmap, cfg->addr, cfg->data);
+		cfg++;
+	}
+}
