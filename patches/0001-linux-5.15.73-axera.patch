+int rtc_set_turn_mode(struct rtc_device *rtc, unsigned int turn_mode)
+{
+	int err;
+
+	err = mutex_lock_interruptible(&rtc->ops_lock);
+	if (err)
+		return err;
+	if (!rtc->ops) {
+		err = -ENODEV;
+	} else if (!rtc->ops->set_turn_mode) {
+		err = -EINVAL;
+	} else {
+		err = rtc->ops->set_turn_mode(rtc->dev.parent, turn_mode);
+		if (err < 0) {
