+
+/*************************************************************************
+  SPI master check status of stream ctrl gpio.
+  SPI slave device must control GPIO level flip when operate read per time.
+ *************************************************************************/
+static void spidev_stream_ctrl_wait(struct spidev_data *spidev)
+{
+	int gpio_state = 0;
+	int timeout = AX_STREAM_CTRL_TIMOUT;
+	int ret = 0;
+
+	if (spidev->stream_ctl_tx_gpio < 0) {
+		/* pr_err("stream gpio is invalid\n"); */
+		return;
+	}
+	ret = wait_event_interruptible_timeout(spidev->stream_ctl_tx_queue,
+			spidev->handshk_gpio_state != gpio_get_value(spidev->stream_ctl_tx_gpio),
+			msecs_to_jiffies(timeout));
+	if (ret < 0) {
+		pr_err("stream ctrl wait event fail\n");
+		return;
+	} else if (0 == ret) {
+		pr_err("SPI Master wait stream gpio timeout \n");
+	} else {
+		gpio_state = gpio_get_value(spidev->stream_ctl_tx_gpio);
+		spidev->handshk_gpio_state = gpio_state;
+	}
+}
+
+static irqreturn_t spidev_stream_ctrl_irq_handler(int irq, void *data)
+{
+	struct spidev_data *spidev = (struct spidev_data *)data;
+	wake_up_interruptible(&spidev->stream_ctl_tx_queue);
+
+	return IRQ_HANDLED;
+}
+
+static int spidev_stream_ctrl_gpio_init(struct spidev_data *spidev)
+{
+	int ret = 0, gpio = -1;
+	int stream_ctl_flag = -1;
+	struct spi_device *spi = spidev->spi;
+
+	spidev->stream_ctl_rx_gpio = gpio;
+	spidev->stream_ctl_tx_gpio = gpio;
+
+	device_property_read_u32(&spi->dev, "stream-ctl-enable", &stream_ctl_flag);
+	if (0 == stream_ctl_flag)
+		return -1;
+
+	gpio = of_get_named_gpio(spi->dev.of_node, "stream-in-gpio", 0);
+	if (gpio < 0) {
+		pr_err("none stream-in-gpio\n");
+	}
+	if (gpio_is_valid(gpio)) {
+		ret = devm_gpio_request(&spi->dev, gpio, dev_name(&spi->dev));
+		if (ret) {
+			pr_err("devm_gpio_request error\n");
+			return ret;
+		} else {
+			gpio_direction_output(gpio, 1);
+			spidev->stream_ctl_rx_gpio = gpio;
+		}
+	} else {
+		pr_err("stream in gpio not valid:%d\n", gpio);
+	}
+
+	gpio = -1;
+	gpio = of_get_named_gpio(spi->dev.of_node, "stream-out-gpio", 0);
+	if (gpio < 0) {
+		pr_err("none stream-out-gpio\n");
+	}
+	if (gpio_is_valid(gpio)) {
+		ret = devm_gpio_request(&spi->dev, gpio, dev_name(&spi->dev));
+		if (ret) {
+			pr_err("devm_gpio_request error\n");
+			return ret;
+		} else {
+			gpio_direction_input(gpio);
+			spidev->stream_ctl_tx_gpio = gpio;
+		}
+	} else {
+		pr_err("stream out gpio not valid:%d\n", gpio);
+	}
+
+	if (-1 == gpio)
+		return gpio;
+	init_waitqueue_head(&spidev->stream_ctl_tx_queue);
+	ret = request_threaded_irq(gpio_to_irq(gpio), spidev_stream_ctrl_irq_handler, NULL,
+			IRQF_SHARED | IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING, "spi stream ctrl", spidev);
+	if (ret < 0) {
+		pr_err("gpio request irq fail\n");
+		devm_gpio_free(&spi->dev, gpio);
+		return ret;
+	}
+	spidev->handshk_gpio_state = -1;
+
+	return 0;
+}
+
+static void spidev_stream_ctrl_gpio_release(struct spidev_data *spidev)
+{
+	int gpio = -1;
+	struct spi_device *spi = spidev->spi;
+
+	gpio = spidev->stream_ctl_tx_gpio;
+	if (gpio_is_valid(gpio)) {
+		free_irq(gpio_to_irq(gpio), spidev);
+		devm_gpio_free(&spi->dev, gpio);
+	}
+
+	gpio = spidev->stream_ctl_rx_gpio;
+	if (gpio_is_valid(gpio)) {
+		devm_gpio_free(&spi->dev, gpio);
+	}
+}
+
+/*-------------------------------------------------------------------------*/
+
+static int spidev_probe(struct spi_device *spi)
+{
+	struct spidev_data	*spidev;
+	int			status;
+	unsigned long		minor;
+
+	/*
+	 * spidev should never be referenced in DT without a specific
+	 * compatible string, it is a Linux implementation thing
+	 * rather than a description of the hardware.
+	 */
+	WARN(spi->dev.of_node && of_device_is_compatible(spi->dev.of_node, "spidev"),
+			"%pOF: buggy DT: spidev listed directly in DT\n", spi->dev.of_node);
+
+	spidev_probe_acpi(spi);
+
+	/* Allocate driver data */
+	spidev = kzalloc(sizeof(*spidev), GFP_KERNEL);
+	if (!spidev)
+		return -ENOMEM;
+
+	/* Initialize the driver data */
+	spidev->spi = spi;
+	spin_lock_init(&spidev->spi_lock);
+	mutex_init(&spidev->buf_lock);
+
+	INIT_LIST_HEAD(&spidev->device_entry);
+
+	/* If we can allocate a minor number, hook up this device.
+	 * Reusing minors is fine so long as udev or mdev is working.
+	 */
+	mutex_lock(&device_list_lock);
+	minor = find_first_zero_bit(minors, N_SPI_MINORS);
+	if (minor < N_SPI_MINORS) {
+		struct device *dev;
+
+		spidev->devt = MKDEV(SPIDEV_MAJOR, minor);
+		dev = device_create(spidev_class, &spi->dev, spidev->devt,
+					spidev, "spidev%d.%d",
+					spi->master->bus_num, spi->chip_select);
+		status = PTR_ERR_OR_ZERO(dev);
+	} else {
+		dev_dbg(&spi->dev, "no minor number available!\n");
+		status = -ENODEV;
+	}
+	if (status == 0) {
+		set_bit(minor, minors);
+		list_add(&spidev->device_entry, &device_list);
+	}
+	mutex_unlock(&device_list_lock);
+
+	spidev->speed_hz = spi->max_speed_hz;
+
+	if (status == 0)
+		spi_set_drvdata(spi, spidev);
+	else
+		kfree(spidev);
+
+	if (!spi_controller_is_slave(spi->controller)) {
+		spidev_stream_ctrl_gpio_init(spidev);
+	}
+
+	return status;
+}
+
+static int spidev_remove(struct spi_device *spi)
+{
+	struct spidev_data	*spidev = spi_get_drvdata(spi);
+
+	if (!spi_controller_is_slave(spi->controller)) {
+		spidev_stream_ctrl_gpio_release(spidev);
+	}
+
+	/* prevent new opens */
+	mutex_lock(&device_list_lock);
+	/* make sure ops on existing fds can abort cleanly */
+	spin_lock_irq(&spidev->spi_lock);
+	spidev->spi = NULL;
+	spin_unlock_irq(&spidev->spi_lock);
+
+	list_del(&spidev->device_entry);
+	device_destroy(spidev_class, spidev->devt);
+	clear_bit(MINOR(spidev->devt), minors);
+	if (spidev->users == 0)
+		kfree(spidev);
+	mutex_unlock(&device_list_lock);
+
+	return 0;
+}
+
+static struct spi_driver spidev_spi_driver = {
+	.driver = {
+		.name =		"spidev",
+		.of_match_table = of_match_ptr(spidev_dt_ids),
+		.acpi_match_table = ACPI_PTR(spidev_acpi_ids),
+	},
+	.probe =	spidev_probe,
+	.remove =	spidev_remove,
+	.id_table =	spidev_spi_ids,
+
+	/* NOTE:  suspend/resume methods are not necessary here.
+	 * We don't do anything except pass the requests to/from
+	 * the underlying controller.  The refrigerator handles
+	 * most issues; the controller driver handles the rest.
+	 */
+};
+
+/*-------------------------------------------------------------------------*/
+
+static int __init spidev_init(void)
+{
+	int status;
+
+	/* Claim our 256 reserved device numbers.  Then register a class
+	 * that will key udev/mdev to add/remove /dev nodes.  Last, register
+	 * the driver which manages those device numbers.
+	 */
+	BUILD_BUG_ON(N_SPI_MINORS > 256);
+	status = register_chrdev(SPIDEV_MAJOR, "spi", &spidev_fops);
+	if (status < 0)
+		return status;
+
+	spidev_class = class_create(THIS_MODULE, "spidev");
+	if (IS_ERR(spidev_class)) {
+		unregister_chrdev(SPIDEV_MAJOR, spidev_spi_driver.driver.name);
+		return PTR_ERR(spidev_class);
+	}
+
+	status = spi_register_driver(&spidev_spi_driver);
+	if (status < 0) {
+		class_destroy(spidev_class);
+		unregister_chrdev(SPIDEV_MAJOR, spidev_spi_driver.driver.name);
+	}
+	return status;
+}
+module_init(spidev_init);
+
+static void __exit spidev_exit(void)
+{
+	spi_unregister_driver(&spidev_spi_driver);
+	class_destroy(spidev_class);
+	unregister_chrdev(SPIDEV_MAJOR, spidev_spi_driver.driver.name);
+}
+module_exit(spidev_exit);
+
+MODULE_AUTHOR("Andrea Paterniani, <a.paterniani@swapp-eng.it>");
+MODULE_DESCRIPTION("User mode SPI device interface");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("spi:spidev");
