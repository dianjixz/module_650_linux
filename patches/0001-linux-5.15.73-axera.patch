+	BW_LOG_DBG("ax_bw_limiter_rd_proc_read = %px", local_entry);
+	id = bw_find_id_by_proc_entry(local_entry, BW_PORT_RD);
+	if (id >= BL_NUM_MAX) {
+		mutex_unlock(&ax_bw_limiter_mutex);
+		BW_LOG_ERR(" fail to find the right id[%d] of sub sys\n", id);
