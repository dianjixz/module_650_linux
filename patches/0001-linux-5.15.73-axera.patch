+    clk_table = devm_kmalloc_array(&pdev->dev, nr_clks, sizeof(*clk_table), GFP_KERNEL);
+    if (!clk_table)
+        return NULL;
+    clk_data->clk_data.clks = clk_table;
+    clk_data->clk_data.clk_num = nr_clks;
+    return clk_data;
+}
