+#define APBTMR_N_CONTROL(N)		(0x08 + (N) * 0x14)
+#define APBTMR_N_EOI(N)			(0x0c + (N) * 0x14)
+#define APBTMR_N_INIT_STATUS(N)		(0x10 + (N) * 0x14)
