+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * es7243l.h -- es7243l ALSA SoC adc driver
+ *
+ * Author:      David Yang, <yangxiaohua@everest-semi.com>
+ * Copyright:   (C) 2019 Everest Semiconductor Co Ltd.,
