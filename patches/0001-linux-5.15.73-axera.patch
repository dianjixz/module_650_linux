+
+static struct regmap_config es8311_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+
+	.max_register = ES8311_MAX_REGISTER,
+	.reg_defaults = es8311_reg_defaults,
+	.num_reg_defaults = ARRAY_SIZE(es8311_reg_defaults),
+	.volatile_reg = es8311_volatile_register,
