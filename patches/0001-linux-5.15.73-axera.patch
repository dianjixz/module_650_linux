+static int es7210_micboost1_setting_get(struct snd_kcontrol *kcontrol,
+					struct snd_ctl_elem_value *ucontrol)
+{
+	u8 val;
+	es7210_read(0x43, &val, i2c_clt1[0]);
+	ucontrol->value.integer.value[0] = val & 0x0f;
+	return 0;
+}
