+	else
+		index += snprintf(buf + index, len - index, "err_det_2_l(%x):invalid\n", SCDC_ERR_DET_2_L);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_ERR_DET_2_H, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "err_det_2_h(%x):%x\n", SCDC_ERR_DET_2_H, val);
+	else
+		index += snprintf(buf + index, len - index, "err_det_2_h(%x):invalid\n", SCDC_ERR_DET_2_H);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_ERR_DET_CHECKSUM, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "err_det_checksum(%x):%x\n", SCDC_ERR_DET_CHECKSUM, val);
