+	value |= (0x1 << BUS_CLK_USB1_EB);	//enable usb bus_clk & ram_clk, at least 60M
+	value |= (0x1 << CLK_USB1_REF_EB);	//ref_clk
+	writel(value, addr);
+	iounmap(addr);
+
+	addr = ioremap(PIPE_CLK_MUX_0, 4);
