+#define JL2XXX_LPA_FIBER_1000FULL	0x20
+#define JL2XXX_BMCR_SPEED_LSB	BIT(13)
+#define JL2XXX_BMCR_SPEED_MSB	BIT(6)
+#define JL2XXX_BMCR_AN_RESTART	BIT(9)
+
