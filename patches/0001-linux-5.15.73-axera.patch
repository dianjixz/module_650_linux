+static ssize_t scdc_status_show(struct device *device, struct device_attribute *attr, char *buf)
+{
+	u8 val;
+	int ret, index = 0, len = PAGE_SIZE;
+	struct drm_connector *connector = dev_get_drvdata(device);
+	struct dw_hdmi *hdmi = container_of(connector, struct dw_hdmi, connector);
+
+	if (!hdmi->ddc)
+		return 0;
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_TMDS_CONFIG, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "tmds_config(%x):%x\n", SCDC_TMDS_CONFIG, val);
+	else
+		index += snprintf(buf + index, len - index, "tmds_config(%x):invalid\n", SCDC_TMDS_CONFIG);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_SCRAMBLER_STATUS, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "scrambler_status(%x):%x\n", SCDC_SCRAMBLER_STATUS, val);
+	else
+		index += snprintf(buf + index, len - index, "scrambler_status(%x):invalid\n", SCDC_SCRAMBLER_STATUS);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_CONFIG_0, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "config_0(%x):%x\n", SCDC_CONFIG_0, val);
+	else
+		index += snprintf(buf + index, len - index, "config_0(%x):invalid\n", SCDC_CONFIG_0);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_STATUS_FLAGS_0, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "status_flags_0(%x):%x\n", SCDC_STATUS_FLAGS_0, val);
+	else
+		index += snprintf(buf + index, len - index, "status_flags_0(%x):invalid\n", SCDC_STATUS_FLAGS_0);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_STATUS_FLAGS_1, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "status_flags_1(%x):%x\n", SCDC_STATUS_FLAGS_1, val);
+	else
+		index += snprintf(buf + index, len - index, "status_flags_1(%x):invalid\n", SCDC_STATUS_FLAGS_1);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_ERR_DET_0_L, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "err_det_0_l(%x):%x\n", SCDC_ERR_DET_0_L, val);
+	else
+		index += snprintf(buf + index, len - index, "err_det_0_l(%x):invalid\n", SCDC_ERR_DET_0_L);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_ERR_DET_0_H, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "err_det_0_h(%x):%x\n", SCDC_ERR_DET_0_H, val);
+	else
+		index += snprintf(buf + index, len - index, "err_det_0_h(%x):invalid\n", SCDC_ERR_DET_0_H);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_ERR_DET_1_L, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "err_det_1_l(%x):%x\n", SCDC_ERR_DET_1_L, val);
+	else
+		index += snprintf(buf + index, len - index, "err_det_1_l(%x):invalid\n", SCDC_ERR_DET_1_L);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_ERR_DET_1_H, &val);
+	if (!ret)
+		index += snprintf(buf + index, len - index, "err_det_1_h(%x):%x\n", SCDC_ERR_DET_1_H, val);
+	else
+		index += snprintf(buf + index, len - index, "err_det_1_h(%x):invalid\n", SCDC_ERR_DET_1_H);
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_ERR_DET_2_L, &val);
