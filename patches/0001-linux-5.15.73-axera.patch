+	int mlc_int_pin;
+	u8 mlc_fsm_en;
+	u16 fsm_mlc_requested_odr;
+	u32 fsm_mlc_requested_uodr;
+	enum st_asm330lhhx_fsm_mlc_enable_id status;
+};
