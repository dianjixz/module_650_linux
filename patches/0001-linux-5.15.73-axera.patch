+#define RTL_W8(tp, reg, val8)	ax_writeb((val8), tp->mmio_addr + (reg))
+#define RTL_W16(tp, reg, val16)	ax_writew((val16), tp->mmio_addr + (reg))
+#define RTL_W32(tp, reg, val32)	ax_writel((val32), tp->mmio_addr + (reg))
+#define RTL_R8(tp, reg)		ax_readb(tp->mmio_addr + (reg))
+#define RTL_R16(tp, reg)		ax_readw(tp->mmio_addr + (reg))
+#define RTL_R32(tp, reg)		ax_readl(tp->mmio_addr + (reg))
+#else
 /* write/read MMIO register */
 #define RTL_W8(tp, reg, val8)	writeb((val8), tp->mmio_addr + (reg))
