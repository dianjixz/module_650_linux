+static bool dw_mipi_dsi_bridge_mode_fixup(struct drm_bridge *bridge,
+			   const struct drm_display_mode *mode,
+			   struct drm_display_mode *adjusted_mode)
+{
+	int ret;
+	u32 tmp, lbcc, lanes;
+	struct dw_mipi_dsi *dsi = bridge_to_dsi(bridge);
+	const struct dw_mipi_dsi_phy_ops *phy_ops = dsi->plat_data->phy_ops;
+	void *priv_data = dsi->plat_data->priv_data;
+
+	lanes = dw_mipi_dsi_get_lanes(dsi);
+	ret = phy_ops->get_lane_mbps(priv_data, adjusted_mode, dsi->mode_flags,
+				     lanes, dsi->format, &dsi->lane_mbps);
+	if (ret)
+		DRM_DEBUG_DRIVER("Phy get_lane_mbps() failed\n");
+
+	if (!(dsi->mode_flags & MIPI_DSI_MODE_VIDEO_BURST)) {
+		lbcc = dw_mipi_dsi_get_hcomponent_lbcc(dsi, mode, mode->htotal);
+		tmp = mode->htotal * dsi->lane_mbps * MSEC_PER_SEC / 8;
+		adjusted_mode->clock = tmp / lbcc;
+		if (tmp % lbcc)
+			adjusted_mode->clock += 1;
+
+		tmp = (adjusted_mode->clock * mode->vtotal) + (mode->clock + 1) / 2;
+		adjusted_mode->vtotal = tmp / mode->clock;
+		if (adjusted_mode->vtotal < mode->vtotal) {
+			tmp = mode->vtotal - adjusted_mode->vtotal;
+			if (adjusted_mode->vtotal <= adjusted_mode->vsync_end)
+				adjusted_mode->vsync_end -= tmp;
+
+			if (adjusted_mode->vsync_end <= adjusted_mode->vsync_start)
+				adjusted_mode->vsync_start -= tmp;
+
+			if (adjusted_mode->vsync_start <= adjusted_mode->vdisplay) {
+				DRM_ERROR("reduced rows:%d, mode: " DRM_MODE_FMT "\n", tmp, DRM_MODE_ARG(mode));
+				return false;
+			}
+		}
+	}
+
+	DRM_DEBUG_DRIVER("mode: " DRM_MODE_FMT "\n", DRM_MODE_ARG(mode));
+	DRM_DEBUG_DRIVER("adjusted_mode: " DRM_MODE_FMT "\n", DRM_MODE_ARG(adjusted_mode));
+
+	return true;
+}
+
