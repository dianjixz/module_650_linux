+	u8 val;
+
+	while (cfg->addr != 0xff) {
+		if (tp2912_read(regmap, cfg->addr, &val)) {
+			pr_err("%s read 0x%x from tp2912 failed\n", __func__, cfg->addr);
+		}
+		pr_info("%s addr: %x, data: %x\n", __func__, cfg->addr, val);
+		cfg++;
+	}
+}
+
+static struct tp2912_priv *tp2912_priv_p;
+
+static void tp2912_regs_dump( void )
+{
+	struct regmap *rmap = NULL;
+	u8 addr=0x00, val=0;
+
+	pr_emerg("%s start\n", __func__);
+	if (IS_ERR_OR_NULL(tp2912_priv_p)) {
+		pr_err("tp2912_priv_p is Null\n");
+		return;
+	}
+	rmap = tp2912_priv_p->regmap;
+
+	pr_emerg("reg  val\n");
+	do {
+		tp2912_read(rmap, addr, &val);
+		pr_emerg("0x%02X 0x%02X\n", addr, val);
+	} while (addr++!=0xFF);
+	pr_emerg("%s end\n", __func__);
+}
+
+void tp2912_mode_sel(int mode)
+{
+	struct regmap *rmap = NULL;
+
+	pr_emerg("%s enter\n", __func__);
+	if (IS_ERR_OR_NULL(tp2912_priv_p)) {
+		pr_err(MODULE_NAME ": module isn't init.\n");
+		return;
+	}
+	rmap = tp2912_priv_p->regmap;
+
+	if (tp2912_priv_p->reset_gpio) {
+		pr_emerg("%s pull reset pin\n", __func__);
+		msleep(300);
+		gpiod_set_value(tp2912_priv_p->reset_gpio, 0);
+		msleep(50);
+		gpiod_set_value(tp2912_priv_p->reset_gpio, 1);
+		msleep(150);
+	}
+
+	switch (mode) {
+	case 0:
+		tp2912_cfg_write(rmap, reg_bt1120_1080p60_setting);
+		break;
+	case 1:
+		tp2912_cfg_write(rmap, reg_bt656_720p30_setting);
+		break;
+	case 2:
+		tp2912_cfg_write(rmap, reg_bt656_1080p25_setting);
+		break;
+	case 3:
+		tp2912_cfg_write(rmap, reg_bt656_1080p30_setting);
+		break;
+	case 4:
+		tp2912_cfg_write(rmap, reg_bt601_1080p25_setting);
+		break;
+	case 5:
+		tp2912_cfg_write(rmap, reg_bt656_720p25_setting);
+		break;
+	case 6:
+		tp2912_cfg_write(rmap, reg_bt656_720p30_36M_setting);
+		break;
+	case 7:
+		tp2912_cfg_write(rmap, reg_bt656_cvbs_ntsc);
+		break;
+	case 8:
+		tp2912_cfg_write(rmap, reg_bt656_cvbs_pal);
+		break;
+	case 9:
+		tp2912_cfg_write(rmap, reg_bt1120_cvbs_ntsc);
+		break;
+	case 10:
+		tp2912_cfg_write(rmap, reg_bt1120_cvbs_pal);
+		break;
+	case 11:
+		tp2912_cfg_write(rmap, reg_bt1120_720p30_setting);
+		break;
+	default:
+		pr_err("%s unsupported mode, mode = %d\n", __func__, mode);
+		break;
+	}
+
+	tp2912_regs_dump();
+	pr_emerg("%s end\n", __func__);
+}
+
+static int tp2912_i2c_probe(struct i2c_client *i2c,
+			    const struct i2c_device_id *id)
+{
+	struct tp2912_priv *tp2912;
+	int error;
+	u32 val_hi, val_lo, i;
+
+	pr_emerg("%s enter\n", __func__);
+	tp2912 = devm_kzalloc(&i2c->dev, sizeof(*tp2912), GFP_KERNEL);
+	if (!tp2912)
+		return -ENOMEM;
+
+	tp2912->regmap = devm_regmap_init_i2c(i2c, &tp2912_regmap_config);
+	if (IS_ERR(tp2912->regmap)) {
+		pr_err("%s unable to allocate register map\n", __func__);
+		return PTR_ERR(tp2912->regmap);
+	}
+
+	//tp2912_cfg_write(tp2912->regmap, reg_setting1);
+
+	//tp2912_cfg_read(tp2912->regmap, reg_setting1);
+
+	dev_set_drvdata(&i2c->dev, tp2912);
+
+	tp2912->reset_gpio = devm_gpiod_get_optional(&i2c->dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(tp2912->reset_gpio))
+		dev_err(&i2c->dev, "%pOF: tp2912 without reset_gpio\n", i2c->dev.of_node);
+	else
+		gpiod_direction_output(tp2912->reset_gpio, 0);
+	/*
+	if (tp2912->reset_gpio) {
+		pr_emerg("%s pull reset pin\n", __func__);
+		gpiod_set_value(tp2912->reset_gpio, 0);
+		msleep(50);
+		gpiod_set_value(tp2912->reset_gpio, 1);
+		msleep(120);
+	}
+	*/
+	tp2912_priv_p = tp2912;
+
+	pr_info("%s done\n", __func__);
+
+	return 0;
+}
+
+static int tp2912_i2c_remove(struct i2c_client *client)
+{
+	tp2912_priv_p = NULL;
+
+	return 0;
+}
+
+static int tp2912_detect(struct i2c_client *client, struct i2c_board_info *info)
+{
+	pr_info("%s enter\n", __func__);
+	return 0;
+};
+
+static const struct i2c_device_id tp2912_id[] = {
+	{"tp2912", 0},
+	{}
+};
+
+MODULE_DEVICE_TABLE(i2c, tp2912_id);
+
+static const struct of_device_id tp2912_of_match[] = {
+	{
+		.compatible = "axera,tp2912",
+	},
+	{}
+};
+
+MODULE_DEVICE_TABLE(of, tp2912_of_match);
+
+
+struct i2c_driver tp2912_i2c_driver = {
+	.driver = {
+		.name = "tp2912",
+		.of_match_table = tp2912_of_match,
+	},
+	.detect = tp2912_detect,
+	.probe = tp2912_i2c_probe,
+	.remove = tp2912_i2c_remove,
+	.id_table = tp2912_id,
+};
+
+module_i2c_driver(tp2912_i2c_driver);
+
+MODULE_DESCRIPTION("Axera TP2912 driver");
+MODULE_LICENSE("GPL v2");
+
