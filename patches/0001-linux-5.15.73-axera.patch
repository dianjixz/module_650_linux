+extern void ax_pcie_spin_lock(unsigned long *flags);
+extern void ax_pcie_spin_unlock(unsigned long *flags);
+static void ax_pcie_rt8169_spin_lock(unsigned long *flags)
+{
+	ax_pcie_spin_lock(flags);
+}
+
+static void ax_pcie_rt8169_spin_unlock(unsigned long *flags)
+{
+	ax_pcie_spin_unlock(flags);
+}
+
+static void ax_writeb(unsigned char b, volatile void __iomem *addr)
+{
+	unsigned long flags;
+
+	ax_pcie_rt8169_spin_lock(&flags);
+	writeb(b, addr);
+	ax_pcie_rt8169_spin_unlock(&flags);
+}
+
+static void ax_writew(unsigned short w, volatile void __iomem *addr)
+{
+	unsigned long flags;
+
+	ax_pcie_rt8169_spin_lock(&flags);
+	writew(w, addr);
+	ax_pcie_rt8169_spin_unlock(&flags);
+}
+
+static void ax_writel(unsigned int l, volatile void __iomem *addr)
+{
+	unsigned long flags;
+
+	ax_pcie_rt8169_spin_lock(&flags);
+	writel(l, addr);
+	ax_pcie_rt8169_spin_unlock(&flags);
+}
+
+static unsigned char ax_readb(const volatile void __iomem *addr)
+{
+	unsigned long flags;
+	unsigned char value;
+
+	ax_pcie_rt8169_spin_lock(&flags);
+	value = readb(addr);
+	ax_pcie_rt8169_spin_unlock(&flags);
+	return value;
+}
+
+static unsigned short ax_readw(const volatile void __iomem *addr)
+{
+	unsigned long flags;
+	unsigned short value;
+
+	ax_pcie_rt8169_spin_lock(&flags);
+	value = readw(addr);
+	ax_pcie_rt8169_spin_unlock(&flags);
+	return value;
+}
+
+static unsigned int ax_readl(const volatile void __iomem *addr)
+{
+	unsigned long flags;
+	unsigned int value;
+
+	ax_pcie_rt8169_spin_lock(&flags);
+	value = readl(addr);
+	ax_pcie_rt8169_spin_unlock(&flags);
+	return value;
+}
+
