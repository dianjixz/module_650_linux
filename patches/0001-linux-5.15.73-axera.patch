+		return err;
+
+	return 0;
+}
+
+static int jl1xxx_dts_intr_cfg_get(struct phy_device *phydev)
+{
+	struct jl1xxx_priv *priv = phydev->priv;
+	struct device_node *of_node = get_device_node(phydev);
+	int err;
+
+	err = of_property_read_u32(of_node, "jl1xxx,interrupt-enable",
+				   &priv->intr.enable);
