+void usb0_vbus_init(char usb_mode)
+{
+	u32 value;
+	void __iomem *addr;
+
+	addr = ioremap(USB0_CTRL, 4);
+	value = readl(addr);
+	if (usb_mode == DEVICE_MODE)
+		value |= (0x1 << VBUSVALID);
+	else
+		value &= (~(0x1 << VBUSVALID));
+	writel(value, addr);
+	iounmap(addr);
+
+	addr = ioremap(USB3_PHY0_CFG3, 4);
+	value = readl(addr);
+	if (usb_mode == DEVICE_MODE)
+		value |= (0x1 << VBUSVLDEXT0);
+	else
+		value &= (~(0x1 << VBUSVLDEXT0));
+	writel(value, addr);
+	iounmap(addr);
+}
