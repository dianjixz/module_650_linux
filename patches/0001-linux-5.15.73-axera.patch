+
+#ifndef __AX_DRM_CRTC_H
+#define __AX_DRM_CRTC_H
+
+#include "ax_drm_drv.h"
+
+#define AX_PLANES_MAX 3
+
+#define VPLL_REF_RATE_27M	27000000
+#define VPLL_REF_RATE_21M	21000000
+
