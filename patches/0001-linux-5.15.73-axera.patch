+static char *special_monitors[] = {
+	"32C1UF",
+	NULL,
+};
+
+static bool is_special_monitor(struct dw_hdmi *hdmi)
+{
+	int i;
+	char name[16];
+	struct edid *edid;
+
+	mutex_lock(&hdmi->connector.dev->mode_config.mutex);
+
+	if (!hdmi->connector.edid_blob_ptr) {
+		mutex_unlock(&hdmi->connector.dev->mode_config.mutex);
+		return false;
+	}
+
+	edid = hdmi->connector.edid_blob_ptr->data;
+	if (!edid) {
+		mutex_unlock(&hdmi->connector.dev->mode_config.mutex);
+		return false;
+	}
+
+	drm_edid_get_monitor_name(edid, name, sizeof(name));
+
+	mutex_unlock(&hdmi->connector.dev->mode_config.mutex);
+
+	DRM_DEBUG_DRIVER("hdmi%d monitor is %s\n", hdmi->id, name);
+
+	for (i = 0; special_monitors[i] != NULL; i += 1) {
+		if (!strcmp(name, special_monitors[i]))
+			return true;
+	}
+
+	return false;
+}
