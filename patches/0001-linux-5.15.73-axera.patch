+/*
+* Clock Managerment
+*/
+#define ES8156_MAINCLOCK_CTL_REG01     0x01
+#define ES8156_SCLK_MODE_REG02     		 0x02
+#define ES8156_LRCLK_DIV_H_REG03     0x03
+#define ES8156_LRCLK_DIV_L_REG04    0x04
+#define ES8156_SCLK_DIV_REG05    0x05
