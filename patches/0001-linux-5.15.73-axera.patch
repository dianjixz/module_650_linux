+};
+
+enum dw_intr_type {
+	I2S_MASTER,
+	I2S_SLAVER,
+	TDM_MASTER,
+	TDM_SLAVER,
+};
+
+struct dw_i2s_dev {
+	void __iomem *i2s_base;
+	struct clk *i2s_pclk;
+	struct clk *clk;
+	struct clk *i2s_mclk;
+	int hdmi_i2s;
