+#include "es8311.h"
+#ifndef CONFIG_OF
+#define CONFIG_OF
+#endif
+/*
+ * es8311 register cache
+ */
+static struct reg_default  es8311_reg_defaults[] = {
+	{ 0x00, 0x1f },
+	{ 0x01, 0x00 },
+	{ 0x02, 0x00 },
+	{ 0x03, 0x10 },
+	{ 0x04, 0x10 },
+	{ 0x05, 0x00 },
+	{ 0x06, 0x03 },
+	{ 0x07, 0x00 },
+	{ 0x08, 0xff },
+	{ 0x09, 0x00 },
