+int ax_gpio_try_lock(void)
+{
+	int i = 0;
+
+	if ((ax_gpio_hwlock->bank->ops->trylock(ax_gpio_hwlock))) {
+		while (1) {
+			i++;
+			if (i > LOCK_COUNT)
+				return 1;
+			if (!(ax_gpio_hwlock->bank->ops->trylock(ax_gpio_hwlock)))
+				return 0;
+		}
+	}
+
+	return 0;
+}
+int ax_gpio_hwunlock(void)
