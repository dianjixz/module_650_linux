+static void es8388_register_init(struct snd_soc_component *component)
+{
+	printk("es8388_register_init\n");
+	snd_soc_component_write(component, 0x1a, 0x00); // LDAC digital volume
+	snd_soc_component_write(component, 0x1b, 0x00); // RDAC digital volume
+	snd_soc_component_write(component, 0x2e, 0x1c); // LOUT1 playback volume
+	snd_soc_component_write(component, 0x2f, 0x1c); // ROUT1 playback volume
+
+	//snd_soc_component_write(component, 0x0a, 0x50); // select LIN2&RIN2 as Microphone
+	snd_soc_component_write(component, 0x10, 0x00); // LADC digital volume = 0DB
+	snd_soc_component_write(component, 0x11, 0x00); // RADC digital volume = 0DB
+	snd_soc_component_write(component, 0x09, 0x88); // MIC PGA=24DB
+
+	snd_soc_component_write(component, 0x27, 0xb8); // mixer
+	snd_soc_component_write(component, 0x2a, 0xb8); // mixer
+
+	snd_soc_component_write(component, 0x2b, 0x80);
+	//snd_soc_component_write(component, 0x00, 0x16);
+	//snd_soc_component_write(component, 0x03, 0x09);
+}
