+void usb_sw_rst(struct dwc3 *dwc)
+{
+	int usb_id = dwc->usb_id;
+	dev_info(dwc->dev, "configure usb%d sw reset\n", dwc->usb_id);
+
+	switch (usb_id) {
+	case USB0:
+		usb0_sw_rst();
+		break;
+	case USB1:
+		usb1_sw_rst();
+		break;
+	case USB2:
+		usb2_sw_rst();
+		break;
+	default:
+		dev_err(dwc->dev, "unsupport usb%d vbus init\n", dwc->usb_id);
+		break;
+	}
+}
