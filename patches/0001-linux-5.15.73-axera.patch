+#define JL1XXX_MDI_AMPLITUDE_EN		(1 << 3)
+
+/* PHY MDI Rate Select */
+#define JL1XXX_MDI_RATE_STANDARD	0
+#define JL1XXX_MDI_RATE_ACCELERATE	1
+
+/* PHY MDI Amplitude Select */
