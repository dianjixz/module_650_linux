+static ssize_t es8311_reset_store(struct device *dev,
+            struct device_attribute *attr,
+            const char *buf, size_t count)
+{
+    struct i2c_client *i2c_client = to_i2c_client(dev);
+    int reg;
+    int ret;
+    
+    printk("ES8311: Starting reset and register write\n");
+    for (reg = 0; reg < 256; reg++) {
+        u8 write_cmd[2] = { 0 };
+        write_cmd[0] = reg;
+        write_cmd[1] = device_regs[reg];
+        
+        ret = i2c_master_send(i2c_client, write_cmd, 2);
+        if (ret < 0) {
+            printk("ES8311: Failed to write reg 0x%02x, ret=%d\n", reg, ret);
+            return ret;
+        }
+    }
+    
+    printk("ES8311: Reset complete, all %d registers written\n", reg);
+    
+    return count;
+}
